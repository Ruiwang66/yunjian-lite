PORT=5050
BIND_ADDR=127.0.0.1
# Public installations must configure an HTTPS origin, e.g. https://monitor.example.com
# Leave empty only for local loopback development.
PUBLIC_URL=
COOKIE_SECURE=false
# HTTPS PUBLIC_URL always forces Secure cookies.
# Only explicitly trusted proxy source CIDRs; never 0.0.0.0/0.
TRUSTED_PROXY_CIDRS=
# Temporary migration switch only; true disables required replay protection for old clients.
ALLOW_LEGACY_REPORTS=false
METRIC_RETENTION_DAYS=7
DOCKERFILE=Dockerfile
